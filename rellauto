		local HttpService = game:GetService("HttpService")
		local STATS_FILE = "Qustah/rellauto.json"
		local startSpins = player.statz.spins.Value
		local stats = { total = 0, rollbacks = 0 }
		pcall(function()
			if isfile and isfile(STATS_FILE) then
				local saved = HttpService:JSONDecode(readfile(STATS_FILE))
				stats.total = tonumber(saved.total) or 0
				stats.rollbacks = tonumber(saved.rollbacks) or 0
			end
		end)
		local function saveStats()
			pcall(function()
				if isfolder and not isfolder("Qustah") then makefolder("Qustah") end
				writefile(STATS_FILE, HttpService:JSONEncode(stats))
			end)
		end
		local function usedThisSession()
			return math.max(0, startSpins - player.statz.spins.Value)
		end
		-- (counted once: the spin loops send the rollback more than once)
		local rolledBack = false
		local function countRollback()
			if rolledBack then return end
			rolledBack = true
			-- this script again in the next server (the rejoin)
			local queue = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
			if queue then pcall(queue, "loadstring(game:HttpGet('" .. SCRIPT_URL .. "', true))()") end
			stats.total = stats.total + usedThisSession()
			stats.rollbacks = stats.rollbacks + 1
			saveStats()
		end
		
